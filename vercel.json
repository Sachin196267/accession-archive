{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "accession/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/api/tick", "schedule": "0 6 * * *" }]
}
